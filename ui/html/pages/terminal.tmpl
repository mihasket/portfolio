{{define "title"}}Terminal{{end}}

{{define "main"}}
    <div class="terminal w-100-p">
        <div class="p-5">
            <div class="flex p-0 m-0">
                <span class="yellow">miha</span>
                <span>@</span>
                <span class="orange">mp3</span>
                <span class="path blue pl-5"></span>
            </div>
            <div class="flex">
                <label for="fname">></label>
                <input class="pl-5" type="text" id="fname" name="fname">
                <span class="blinking-cursor"></span>
            </div>
        </div>
    </div>
{{end}}
