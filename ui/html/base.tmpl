{{define "base"}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel='stylesheet' href='https://cdn.jsdelivr.net/gh/mihasket/dotfiles@master/.config/waybar/style.css'>
        <link rel='stylesheet' href='/static/css/main.css'>
        <link rel='shortcut icon' href='/static/img/favicon.ico' type='image/x-icon'>
        <title>{{template "title" .}} - Miha Šket</title>
    </head>
    <body>
        <header>
            {{template "waybar" .}}
        </header>

        <main id="main" class="flex-center-100 items-stretch">
            {{template "main" .}}
        </main>

        <div class="mobile">
            {{template "mobile" .}}
        </div>

        <script type="module" src='/static/js/main.js'></script>
    </body>
</html>
{{end}}
